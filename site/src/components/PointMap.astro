---
// Interactive map (MapLibre GL JS). Pan, zoom, hover or tap a circle for details.
// Reads a GeoJSON file of points. Basemap: OpenFreeMap (free, no API key).
interface Props {
	file: string; // file name inside data/processed, e.g. "points.geojson"
	label: string; // plain description for screen readers
}

const { file, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/data/${file}`;
---

<figure class="map-figure">
	<div class="map" data-src={src} role="region" aria-label={label}></div>
	<figcaption>
		Drag to pan, use two fingers or Ctrl + scroll to zoom. <a href={src}>Download the data (GeoJSON)</a>.
	</figcaption>
</figure>

<script>
	import * as maplibregl from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	// MapLibre does its heavy tile work in a background worker file.
	// "?url" makes the bundler copy that file into the build and give us its address.
	import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';

	maplibregl.setWorkerUrl(workerUrl);

	const STYLE = 'https://tiles.openfreemap.org/styles/positron';

	document.querySelectorAll<HTMLElement>('.map[data-src]').forEach((el) => {
		// Wait until the map scrolls into view, so the page loads fast.
		const watcher = new IntersectionObserver((entries) => {
			if (!entries.some((e) => e.isIntersecting)) return;
			watcher.disconnect();
			start(el);
		});
		watcher.observe(el);
	});

	async function start(el: HTMLElement) {
		const data = await (await fetch(el.dataset.src!)).json();

		const map = new maplibregl.Map({
			container: el,
			style: STYLE,
			center: [-98, 39],
			zoom: 3,
			cooperativeGestures: true, // so scrolling the page does not get trapped by the map
		});
		map.addControl(new maplibregl.NavigationControl({ showCompass: false }));

		// Zoom to fit all the points.
		const bounds = new maplibregl.LngLatBounds();
		for (const f of data.features) bounds.extend(f.geometry.coordinates);
		map.fitBounds(bounds, { padding: 60, maxZoom: 6, animate: false });

		map.on('load', () => {
			map.addSource('points', { type: 'geojson', data });
			map.addLayer({
				id: 'points',
				type: 'circle',
				source: 'points',
				paint: {
					// Bigger circle = bigger change. Adjust the numbers to fit your data.
					'circle-radius': ['interpolate', ['linear'], ['get', 'change'], 0, 6, 60, 22],
					'circle-color': '#1a5fb4',
					'circle-opacity': 0.75,
					'circle-stroke-color': '#ffffff',
					'circle-stroke-width': 1.5,
				},
			});

			const popup = new maplibregl.Popup({ closeButton: false, closeOnClick: false, offset: 12 });

			const show = (e: maplibregl.MapMouseEvent & { features?: maplibregl.MapGeoJSONFeature[] }) => {
				const f = e.features?.[0];
				if (!f) return;
				map.getCanvas().style.cursor = 'pointer';
				// Build the text with textContent, not HTML, so data can never inject markup.
				const box = document.createElement('div');
				const title = document.createElement('strong');
				title.textContent = String(f.properties.city);
				const detail = document.createElement('div');
				detail.textContent = `Latest: ${f.properties.latest}  |  Change: +${f.properties.change}`;
				box.append(title, detail);
				popup
					.setLngLat((f.geometry as GeoJSON.Point).coordinates as [number, number])
					.setDOMContent(box)
					.addTo(map);
			};

			map.on('mousemove', 'points', show);
			map.on('click', 'points', show); // taps on touch screens
			map.on('mouseleave', 'points', () => {
				map.getCanvas().style.cursor = '';
				popup.remove();
			});
		});
	}
</script>
